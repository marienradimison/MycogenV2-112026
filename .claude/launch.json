{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mycogen",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["manage.py", "runserver", "8000"],
      "port": 8000
    },
    {
      "name": "mycogen-sqlite-demo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set DB_ENGINE=sqlite&& .venv\\Scripts\\python manage.py runserver 8002"],
      "port": 8002
    }
  ]
}
