# Copier ce fichier en .env puis adapter les valeurs.
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
# Production intranet : False
DJANGO_DEBUG=True
# Adresse(s) par lesquelles les postes accèdent au serveur (IP du serveur, nom réseau)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.67.89
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mycogen.pasteur.mg

# PostgreSQL
DB_NAME=mycogen
DB_USER=mycogen
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# Serveur web (python manage.py serve). Avec la passerelle Node sous Windows (dossier MycogenV2-NodeJS),
# MYCOGEN n'écoute qu'en local et c'est la passerelle qui le publie sur le réseau (port 8000) :
# MYCOGEN_HOST=127.0.0.1
# MYCOGEN_PORT=8001
